# ==========================================
# Encadrini Backend Environment Variables
# ==========================================

PROJECT_NAME="Encadrini Platform API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="encadrini_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs & CORS
FRONTEND_URL="http://localhost:5173/encadrini-ai/"
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# MongoDB Database
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="encadrini_db"

# MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="encadrini-reports"
MINIO_SECURE=False

# AI Provider Configuration
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-fake-key-for-dev"

# ==========================================
# Email Configuration
# ==========================================
# NOTE: Render Free tier BLOCKS outbound SMTP ports (25, 465, 587).
# If hosting on Render Free, configure RESEND_API_KEY or BREVO_API_KEY below (runs over HTTPS port 443).

# Option A: Resend HTTPS API (Recommended for Render Free, get free key at https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Encadrini <onboarding@resend.dev>"

# Option B: Brevo HTTPS API (Get free key at https://brevo.com)
BREVO_API_KEY=""
BREVO_FROM_EMAIL="encadriniai@gmail.com"

# Option C: Standard SMTP (For Local Development, VPS, or Render Paid plans)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password-here"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_USE_TLS=True

# ==========================================
# Tunisian Payment Gateways (Konnect, Flouci, Paymee)
# ==========================================
# Premium Monthly Price in TND (Tunisian Dinars)
PREMIUM_PRICE_TND=25.0

# 1. Konnect (https://konnect.network)
# Accepts: e-Dinar, Cartes Bancaires (GIE), Flouci wallet
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""
KONNECT_MODE="sandbox" # "sandbox" or "production"

# 2. Flouci (https://developer.flouci.com)
# Accepts: Flouci Mobile Wallet & QR Code
FLOUCI_APP_PUBLIC_KEY=""
FLOUCI_APP_SECRET=""

# 3. Paymee (https://paymee.tn)
# Accepts: Cartes Bancaires CIB & e-Dinar
PAYMEE_API_KEY=""
PAYMEE_VENDOR_ID=""
PAYMEE_MODE="sandbox" # "sandbox" or "production"

# ==========================================
# RAG & Semantic Retrieval (Qdrant & Embeddings)
# ==========================================
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="pfe_knowledge_chunks"
EMBED_MODEL="BAAI/bge-m3"
EMBED_DEVICE="cpu"
RAG_TOP_K=5
