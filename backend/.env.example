# ==========================================
# Encadrini Backend Environment Variables
# ==========================================

PROJECT_NAME="Encadrini Platform API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="encadrini_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs & CORS
FRONTEND_URL="http://localhost:5173/encadrini-ai/"
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# MongoDB Database
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="encadrini_db"

# MinIO / S3 Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="encadrini-reports"
MINIO_SECURE=False

# AI Provider Configuration
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-fake-key-for-dev"

# Email / SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password-here"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_USE_TLS=True
